[gd_resource type="Resource" script_class="TagDatabase" format=3]

[ext_resource type="Script" path="res://scripts/resources/tag_category.gd" id="1_category"]
[ext_resource type="Script" path="res://scripts/resources/tag_database.gd" id="2_db"]

[sub_resource type="Resource" id="Resource_ore"]
script = ExtResource("1_category")
tag_name = "<ore>"
items = Array[String](["iron_ore", "coal", "mana_crystal"])

[sub_resource type="Resource" id="Resource_ingot"]
script = ExtResource("1_category")
tag_name = "<ingot>"
items = Array[String](["iron_ingot", "runesteel_ingot"])

[resource]
script = ExtResource("2_db")
categories = Array[ExtResource("1_category")]([SubResource("Resource_ore"), SubResource("Resource_ingot")])
